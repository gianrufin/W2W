# Supabase — the only data source. The app shows nothing without it.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Required by the scraper pipeline; never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Map tiles. Leave blank to fall back to keyless raster basemaps.
NEXT_PUBLIC_MAPTILER_KEY=

# Optional: fills posters/synopses for titles the chains publish without art.
TMDB_API_KEY=
