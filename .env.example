# Supabase — the only data source. The app shows nothing without it.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Required by the scraper pipeline; never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Map tiles. Leave blank to fall back to keyless raster basemaps.
NEXT_PUBLIC_MAPTILER_KEY=

# Optional: fills posters/synopses for titles the chains publish without art.
TMDB_API_KEY=

# Optional: live and predicted driving times, for the "leave by" estimate.
#
# Generate a NEW public token — an account's default one cannot take URL
# restrictions — scope it to Directions, and restrict it to your deployment's
# domain. It ships in the client bundle by design; the URL restriction is what
# protects it, and restrictions only apply to browser requests.
#
# Without it the app falls back to a time-of-day traffic model, which always
# works and is labelled "typical traffic" rather than "live traffic".
NEXT_PUBLIC_MAPBOX_TOKEN=
