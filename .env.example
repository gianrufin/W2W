# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Required by the seed script and the scraper pipeline.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Map tiles. Leave blank to fall back to the free MapLibre demo dark style.
NEXT_PUBLIC_MAPTILER_KEY=
NEXT_PUBLIC_MAPBOX_TOKEN=

# Set to "true" to run the UI entirely from lib/mock-data.ts (no Supabase needed).
NEXT_PUBLIC_USE_MOCK_DATA=true
